<?xml version="1.0" encoding="utf-8"?>
<!--
    Android memblokir HTTP tanpa TLS sejak Android 9 (API 28).
    Backend pengembangan berjalan di http://10.0.2.2:8000, sehingga cleartext
    hanya diizinkan untuk alamat lokal pengembangan. Trafik ke domain lain
    tetap wajib HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Alamat host machine dari dalam Android Emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
